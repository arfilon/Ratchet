@page "/"
@using RatchetTestRunner.Models
@using RatchetTestRunner.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject ITestDiscoveryService TestDiscoveryService
@inject ITestExecutionService TestExecutionService
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Test Discovery</h5>
                </div>
                <div class="card-body">
                    @if (assemblies == null)
                    {
                        <p><em>Loading tests...</em></p>
                    }
                    else if (assemblies.Count == 0)
                    {
                        <p><em>No tests found. Configure assembly paths in appsettings.json</em></p>
                    }
                    else
                    {
                        <div class="test-selector">
                            @foreach (var assembly in assemblies)
                            {
                                <div class="assembly-group">
                                    <strong>@assembly.Name</strong>
                                    @foreach (var testClass in assembly.Classes)
                                    {
                                        <div class="class-group ms-3">
                                            <em>@testClass.Name</em>
                                            <ul class="list-unstyled ms-3">
                                                @foreach (var method in testClass.Methods)
                                                {
                                                    <li>
                                                        <button class="btn btn-sm btn-outline-primary"
                                                                @onclick="() => SelectTest(method)">
                                                            @method.Name
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <button class="btn btn-primary mt-3" @onclick="RefreshTests">Refresh</button>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Execution Results</h5>
                </div>
                <div class="card-body">
                    @if (selectedTest != null)
                    {
                        <div class="alert alert-info">
                            Selected: <strong>@selectedTest.ParentClass?.Name.@selectedTest.Name</strong>
                            <button class="btn btn-sm btn-success float-end" @onclick="ExecuteSelectedTest" disabled="@isExecuting">
                                @if (isExecuting)
                                {
                                    <span>Executing...</span>
                                }
                                else
                                {
                                    <span>Execute</span>
                                }
                            </button>
                        </div>
                    }

                    @if (currentResult != null)
                    {
                        <div class="test-results">
                            <h6>Test: @currentResult.TestMethod?.DisplayName</h6>
                            <p>Status: <span class="badge @GetStatusBadgeClass(currentResult.Status)">@currentResult.Status</span></p>
                            <p>Duration: @currentResult.Duration.TotalMilliseconds.ToString("F0") ms</p>

                            @if (currentResult.Exceptions.Any())
                            {
                                <div class="alert alert-danger mt-3">
                                    <h6>Exceptions:</h6>
                                    @foreach (var ex in currentResult.Exceptions)
                                    {
                                        <div class="exception-details">
                                            <strong>@ex.ExceptionType:</strong> @ex.Message
                                            <pre class="mt-2 small">@ex.StackTrace</pre>
                                        </div>
                                    }
                                </div>
                            }

                            @if (currentResult.BrowserOutput.Any())
                            {
                                <div class="alert alert-info mt-3">
                                    <h6>Browser Console Output:</h6>
                                    <div class="console-output">
                                        @foreach (var msg in currentResult.BrowserOutput)
                                        {
                                            <div class="console-message" style="color: @GetConsoleColor(msg.Level);">
                                                [@msg.Timestamp.ToString("HH:mm:ss")] @msg.Text
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (currentResult.Steps.Any())
                            {
                                <div class="mt-3">
                                    <h6>Test Steps:</h6>
                                    <table class="table table-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Action</th>
                                                <th>Duration (ms)</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var step in currentResult.Steps)
                                            {
                                                <tr>
                                                    <td>@step.Index</td>
                                                    <td>@step.Action <small>@step.Details</small></td>
                                                    <td>@step.Duration.TotalMilliseconds.ToString("F0")</td>
                                                    <td>@step.Status</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TestAssemblyInfo>? assemblies;
    private TestMethodInfo? selectedTest;
    private TestExecutionResult? currentResult;
    private bool isExecuting = false;
    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await RefreshTests();
    }

    private async Task RefreshTests()
    {
        try
        {
            // Get assembly paths from configuration
            var assemblyPaths = new[]
            {
                "/home/user/Ratchet/src/Test/UnitTest/bin/Debug/net8.0/UnitTest.dll"
            };

            assemblies = await TestDiscoveryService.DiscoverAssembliesAsync(assemblyPaths);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tests: {ex.Message}");
        }
    }

    private void SelectTest(TestMethodInfo method)
    {
        selectedTest = method;
        currentResult = null;
    }

    private async Task ExecuteSelectedTest()
    {
        if (selectedTest == null) return;

        isExecuting = true;
        try
        {
            var request = new TestExecutionRequest { TestMethod = selectedTest };
            currentResult = await TestExecutionService.ExecuteTestAsync(selectedTest, request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error executing test: {ex.Message}");
        }
        finally
        {
            isExecuting = false;
        }
    }

    private string GetStatusBadgeClass(TestStatus status) => status switch
    {
        TestStatus.Passed => "bg-success",
        TestStatus.Failed => "bg-danger",
        TestStatus.Error => "bg-danger",
        TestStatus.Running => "bg-warning",
        TestStatus.Pending => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetConsoleColor(ConsoleLevel level) => level switch
    {
        ConsoleLevel.Error => "red",
        ConsoleLevel.Warning => "orange",
        ConsoleLevel.Info => "blue",
        _ => "black"
    };

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
