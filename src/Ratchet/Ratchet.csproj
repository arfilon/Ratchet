<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Arfilon.Ratchet</RootNamespace>
    <AssemblyName>Arfilon.Ratchet</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.0.0</Version>
    <PackageProjectUrl>https://github.com/arfilon/Ratchet</PackageProjectUrl>
    <Authors>Arfilon</Authors>
    <Description>Ratchet - End-to-End browser testing library for ASP.NET Core applications</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>testing;e2e;aspnetcore;browser</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Knyaz.Optimus" Version="2.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
  </ItemGroup>

</Project>
